APP_NAME=SIMONEV-CPL
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Zona waktu WIT (Ternate) dan bahasa Indonesia
APP_TIMEZONE=Asia/Jayapura
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database MySQL untuk aplikasi. Test memakai database terpisah
# simonev_cpl_test (diatur di phpunit.xml) dengan user yang sama.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simonev_cpl
DB_USERNAME=simonev
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local

# Aplikasi tidak memakai antrean, jadi tabel jobs dan failed_jobs tidak dibuat
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=null

CACHE_STORE=database

# Ambang batas capaian (bagian 5.3 spesifikasi). Angka di bawah hanya contoh
# APTIKOM untuk pengembangan: GANTI sesuai ketetapan program studi.
# Pakai titik sebagai pemisah desimal. Setelah nilainya diubah, jalankan
# `php artisan config:clear` agar nilai baru terbaca.
# Ambang Batas Kelulusan Mahasiswa, skala 0–100
AMBANG_KELULUSAN_MAHASISWA=50.01
# Ambang Batas Ketercapaian, persen 0–100 (85 berarti 85%)
AMBANG_KETERCAPAIAN=85
